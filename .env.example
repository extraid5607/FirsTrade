# ZeroPaper India - settings. Set these as ENVIRONMENT VARIABLES (the app never reads this file itself).

# demo = simulated prices (safe, works anywhere). live = real prices from Groww / Yahoo / NSE.
PRICE_SOURCE=demo

# Database. Leave empty for a local SQLite file. On Render use the Postgres "Internal Database URL".
DATABASE_URL=

# Sign-up gate: when set, new accounts need this code. Use it with live data (your students only).
INVITE_CODE=
# This username can open /api/admin/overview and set the daily Groww token.
ADMIN_USERNAME=

# Groww Trade API. Easiest: paste today's access token (it expires every day around 6 am IST).
GROWW_ACCESS_TOKEN=
# Or let the app fetch the token itself (the key must be approved each day on Groww Cloud):
GROWW_API_KEY=
GROWW_API_SECRET=

# Order of data sources.
PROVIDERS=groww,yahoo
CHAIN_PROVIDERS=groww,nse

# Account and safety.
START_BALANCE=1000000
COOKIE_SECURE=true
SQUAREOFF_TIME=15:20
STALE_AFTER=30
# Demo only: treat the market as always open so you can test at night. Defaults to true in demo, false in live.
FORCE_MARKET_OPEN=

# Approximate margins (see DECISIONS.md).
MIS_LEVERAGE=5
FUTURES_MARGIN_PCT=11
OPTION_SELL_MARGIN_PCT=12
FNO_STOCK_UNDERLYINGS=RELIANCE,HDFCBANK,ICICIBANK,SBIN,TCS,INFY,AXISBANK,ITC
